# Copy to .env and fill in
BOT_NAME=POUNDZ MD
PREFIX=.
MODE=public
# Comma-separated, country code, no + sign
OWNER_NUMBER=254700000000
OWNER_NAME=Poundz
# Set this to pair with a code instead of scanning a QR (your bot's number, no +)
PAIR_NUMBER=
STICKER_PACK=POUNDZ MD
STICKER_AUTHOR=Poundz
TIME_ZONE=Africa/Nairobi

# Optional: restore login on hosts with no persistent disk (starts with POUNDZ~, generate with `npm run session` or .session)
SESSION_ID=
